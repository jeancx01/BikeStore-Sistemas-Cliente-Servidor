@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">

    <!-- TARJETAS PRINCIPALES -->
    <section class="summary-grid">

        <article class="summary-card">
            <div class="summary-icon blue">
                <i class="bi bi-bicycle"></i>
            </div>

            <div class="summary-info">
                <span class="summary-title">Bicicletas</span>
                <strong>18</strong>
                <small>Total registradas</small>
                <div class="summary-growth success">
                    <i class="bi bi-arrow-up"></i>
                    8% <span>vs. mes anterior</span>
                </div>
            </div>
        </article>


        <article class="summary-card">
            <div class="summary-icon green">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="summary-info">
                <span class="summary-title">Clientes</span>
                <strong>12</strong>
                <small>Total registrados</small>
                <div class="summary-growth success">
                    <i class="bi bi-arrow-up"></i>
                    12% <span>vs. mes anterior</span>
                </div>
            </div>
        </article>


        <article class="summary-card">
            <div class="summary-icon orange">
                <i class="bi bi-cart3"></i>
            </div>

            <div class="summary-info">
                <span class="summary-title">Ventas del día</span>
                <strong>$ 680.00</strong>
                <small>6 ventas realizadas</small>
                <div class="summary-growth success">
                    <i class="bi bi-arrow-up"></i>
                    15% <span>vs. ayer</span>
                </div>
            </div>
        </article>


        <article class="summary-card">
            <div class="summary-icon red">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="summary-info">
                <span class="summary-title">Stock bajo</span>
                <strong>3</strong>
                <small>Productos con bajo stock</small>

                <a href="#" class="summary-link">
                    Ver detalles
                </a>
            </div>
        </article>


        <!-- ACCIONES RÁPIDAS -->
        <article class="quick-actions">

            <button class="quick-button primary-action">
                <i class="bi bi-plus-lg"></i>
                Nueva venta
            </button>

            <button class="quick-button">
                <i class="bi bi-bicycle"></i>
                Nueva bicicleta
            </button>

            <button class="quick-button">
                <i class="bi bi-person-plus"></i>
                Nuevo cliente
            </button>

        </article>

    </section>

</div>